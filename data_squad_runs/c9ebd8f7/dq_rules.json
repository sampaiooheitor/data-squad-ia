{
  "rules": [
    {
      "column": "id_lancamento",
      "rule_type": "not_null",
      "expression": "value IS NOT NULL",
      "severity": "error"
    },
    {
      "column": "id_lancamento",
      "rule_type": "unique",
      "expression": "COUNT(DISTINCT value) = COUNT(value)",
      "severity": "error"
    },
    {
      "column": "dt_referencia",
      "rule_type": "not_null",
      "expression": "value IS NOT NULL",
      "severity": "error"
    },
    {
      "column": "dt_referencia",
      "rule_type": "regex",
      "expression": "value REGEXP '^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$'",
      "severity": "warning"
    },
    {
      "column": "cpf_cliente",
      "rule_type": "not_null",
      "expression": "value IS NOT NULL",
      "severity": "error"
    },
    {
      "column": "cpf_cliente",
      "rule_type": "regex",
      "expression": "value REGEXP '^\\d{11}$'",
      "severity": "warning"
    },
    {
      "column": "valor",
      "rule_type": "not_null",
      "expression": "value IS NOT NULL",
      "severity": "warning"
    },
    {
      "column": "valor",
      "rule_type": "range",
      "expression": "value BETWEEN -999999999.99 AND 999999999.99",
      "severity": "warning"
    }
  ]
}